set format sparse with omit null, raw json (payload), space 4;;
set format csv with header, delimiter ',', row delimiter '\n', null '-', quote '"', escape '\\', encoding 'utf-8';;

range(1, 3) output to stdout format csv with header;;
range(1, 3) output format sparse with raw json (payload) to file 'out.ndjson';;
range(1, 3) output format csv with header to file @target;;
range(1, 3) output format raw to file E'./logs/out.log';;
range(1, 3) output format csv to url 'https://example.com/upload';;
range(1, 3) output to stderr format dense;;

